rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist — a user can only check their own membership.
    // Add/remove admins from the Firebase Console (Firestore → Data), not the app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Provider catalog — public read (needed for the app's Home/Explore/Detail
    // screens to load). Writes are admin-only (see admin.html), except that
    // any signed-in user may refresh the review aggregate (rating + count)
    // after writing a review — and may touch ONLY those two fields.
    match /providers/{providerId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviews'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.reviews is int && request.resource.data.reviews >= 0;

      // Reviews: public read; one per user (doc id = uid), 1–5 stars, text ≤ 1000 chars.
      // Admins may delete for moderation.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == reviewId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow delete: if (request.auth != null && request.auth.uid == reviewId) || isAdmin();
      }
    }

    // Per-user data — favorites (a field on the user doc), vehicles, and
    // bookings. The owner can read/write their own data; admins can read
    // any user's data for support/oversight, and can write bookings
    // (updating delivery progress) and their chat messages in admin.html.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;

      match /vehicles/{vehicleId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /bookings/{bookingId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

        // Chat between the customer and admin for this booking.
        match /messages/{messageId} {
          allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
        }
      }
      // In-app inbox. The owner reads/marks read; the app (owner) and admin.html
      // (dispatcher) both create entries from real events.
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Collection-group read access so admin.html can query every user's
    // bookings at once (a plain nested rule can't authorize that query shape).
    match /{path=**}/bookings/{bookingId} {
      allow read: if isAdmin();
    }

    // Everything else is denied by default until it's actually needed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
