rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Provider catalog — public read (needed for the app's Home/Explore/Detail
    // screens to load), no client writes. Providers are seeded once via
    // seed.html; update them from the Firebase Console instead of the client.
    match /providers/{providerId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user data — favorites (a field on the user doc), vehicles, and
    // bookings. Only the signed-in owner can read or write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /vehicles/{vehicleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /bookings/{bookingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else is denied by default until it's actually needed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
